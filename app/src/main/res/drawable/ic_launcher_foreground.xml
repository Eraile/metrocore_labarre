<?xml version="1.0" encoding="utf-8"?>
<!-- Le logo metrocore en couleur, pose dans la zone sure d'une icone adaptative.
     Le gabarit fait 108 unites, dont seules les 72 centrales sont garanties visibles :
     le groupe ramene donc la boite de 24 du logo a 60 unites, centrees. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">

        <path android:pathData="M1.5 3.6 L6.2 6.6 L6.2 21.3 L1.5 21.3 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="1.5" android:startY="3.6"
                    android:endX="6.2" android:endY="21.3">
                    <item android:offset="0" android:color="#FF24C2FF" />
                    <item android:offset="1" android:color="#FF309BFF" />
                </gradient>
            </aapt:attr>
        </path>

        <path
            android:pathData="M6.95 6.55 L12.05 9.4 L12.05 15.9 L6.95 12.6 Z"
            android:fillColor="#FF17DEF1" />

        <path
            android:pathData="M12.05 9.4 L17.15 6.55 L17.15 12.6 L12.05 15.9 Z"
            android:fillColor="#FF056C98" />

        <path android:pathData="M22.3 3.6 L22.3 21.3 L17.8 21.3 L17.8 6.6 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="17.8" android:startY="3.6"
                    android:endX="22.3" android:endY="21.3">
                    <item android:offset="0" android:color="#FF6A3BF0" />
                    <item android:offset="1" android:color="#FF6827E9" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
