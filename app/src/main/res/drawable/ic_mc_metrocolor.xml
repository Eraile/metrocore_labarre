<?xml version="1.0" encoding="utf-8"?>
<!-- Le logo metrocore en couleur. Ecrit a la main, pas genere : voir HANDWRITTEN dans
     tools/gen-icons.mjs (qui epargne ce fichier a la purge).

     Geometrie identique a ic_mc_metro (donc a metrocore/src/controls/icons.ts), mais le
     chevron central est coupe en deux a son sommet (x = 12.05) parce que ses deux pans
     n'ont pas la meme teinte. Couleurs relevees sur docs/logo/logo_squared_transparent.png.

     Cette glyphe n'est PAS teintee au runtime : voir NavIcon.tintable. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- montant gauche : cyan vers bleu -->
    <path android:pathData="M1.5 3.6 L6.2 6.6 L6.2 21.3 L1.5 21.3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="1.5" android:startY="3.6"
                android:endX="6.2" android:endY="21.3">
                <item android:offset="0" android:color="#FF24C2FF" />
                <item android:offset="1" android:color="#FF309BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- chevron, pan gauche : cyan vif -->
    <path
        android:pathData="M6.95 6.55 L12.05 9.4 L12.05 15.9 L6.95 12.6 Z"
        android:fillColor="#FF17DEF1" />

    <!-- chevron, pan droit : le meme pan vu dans l'ombre -->
    <path
        android:pathData="M12.05 9.4 L17.15 6.55 L17.15 12.6 L12.05 15.9 Z"
        android:fillColor="#FF056C98" />

    <!-- montant droit : violet -->
    <path android:pathData="M22.3 3.6 L22.3 21.3 L17.8 21.3 L17.8 6.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="17.8" android:startY="3.6"
                android:endX="22.3" android:endY="21.3">
                <item android:offset="0" android:color="#FF6A3BF0" />
                <item android:offset="1" android:color="#FF6827E9" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
